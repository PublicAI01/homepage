# Copy the server-side values into .env.local for local development
# (gitignored). Names only here — never commit values.

# --- Public (inlined into the client bundle at build time) ---

# reCAPTCHA Enterprise site key. Public and domain-bound. The
# production value is committed in .env.production; for local dev,
# set it in .env.local alongside the server-only values below.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Server-only (injected into the container at runtime) ---

# AWS credentials for an IAM user allowed to send via SES.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Region the SES identity is provisioned in, e.g. us-east-1.
AWS_REGION=

# Google Cloud API key used to call the reCAPTCHA Enterprise
# assessments API for the site key above.
RECAPTCHA_SECRET_KEY=

# Comma-separated recipient addresses for business contact requests.
CONTACT_EMAIL_TO=

# Official-accounts data for /api/verify, as one JSON object:
# {"email": ["..."], "x": ["..."], "telegram": ["..."]}
OFFICIAL_ACCOUNTS_JSON=

# Resend, for Index Weekly sign-ups on /model-index. Without both,
# the sign-up route answers 503 rather than silently dropping the
# address. RESEND_AUDIENCE_ID is the Audience the weekly broadcast
# goes to; the API key needs write access to contacts.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Whose word to take for the visitor's address when rate-limiting the forms:
# cloudflare | nginx | none. Production sits behind Cloudflare; leave unset
# locally (nothing in front, so no header is trusted).
# TRUSTED_PROXY=cloudflare
